{
    "name": "consent_banner",
    "version": "1.2.1",
    "description": "Consent Banner style",
    "author": "Andreas Schulze",
    "repository": {
        "type": "git",
        "url": "https://github.com/npm/cli.git"
    },
    "license": "(MIT)",
    "main": "Base.js",
    "scripts": {
        "build": "webpack build --mode=production --config style.webpack.js && webpack build --mode=production --config script.webpack.js",
        "build:dev": "webpack build --mode=development --config style.webpack.js && webpack build --mode=development --config script.webpack.js",
        "script:dev": "webpack build --mode=development --config script.webpack.js",
        "style:dev": "webpack build --mode=development --config style.webpack.js",
        "script": "webpack --mode=production --config script.webpack.js",
        "style": "webpack --mode=production --config style.webpack.js"
    },
    "dependencies": {
        "bezier-easing": "^2.1.0",
        "core-js": "^3.16.4"
    },
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@babel/plugin-syntax-dynamic-import": "7.8.3",
        "@babel/plugin-transform-runtime": "7.28.3",
        "@babel/preset-env": "7.28.3",
        "@babel/register": "^7.15.3",
        "autoprefixer": "^10.4.20",
        "babel-loader": "9.1.3",
        "caniuse-lite": "^1.0.30001743",
        "clean-webpack-plugin": "^4.0.0",
        "css-loader": "^7.1.2",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "cssnano": "7.1.1",
        "file-loader": "^6.2.0",
        "google-closure-compiler": "^20251216.0.0",
        "mini-css-extract-plugin": "^2.7.2",
        "postcss": "^8.4.31",
        "postcss-loader": "^8.1.1",
        "postinstall": "^0.11.2",
        "sass": "^1.93.3",
        "sass-loader": "^16.0.2",
        "sass-migrator": "^1.5.3",
        "style-loader": "^4.0.0",
        "terser-webpack-plugin": "^5.3.14",
        "uglify-js": "^3.14.2",
        "webpack": "^5.105.1",
        "webpack-cli": "6.0.1"
    },
    "overrides": {
        "fast-uri": "^3.1.7"
    }
}
