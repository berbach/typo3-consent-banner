{
    "name": "bb/consent_banner",
    "description": "Consent Banner - Consent Banner Extension with Consent Mode, Consent history, Javascript.",
    "homepage": "https://berbach.com/",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3",
        "CMS",
        "typo3",
        "Extension"
    ],
    "require": {
		"php": ">= 8.3 < 8.6",
        "typo3/cms-core": "^13 || ^14"
    },
	"require-dev": {
		"ergebnis/composer-normalize": "^2.42",
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^10.5",
		"saschaegerer/phpstan-typo3": "^2.1",
		"ssch/typo3-debug-dump-pass": "^v0.0.2",
		"symfony/debug-bundle": "^6.4",
		"typo3/cms-install": ">= 13.4 <= 14.3",
		"typo3/testing-framework": "^8.3",
		"typo3/coding-standards": "^0.8.0"
	},
    "autoload": {
        "psr-4": {
            "Bb\\ConsentBanner\\": "Classes/"
        }
    },
	"minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
		"vendor-dir": ".build/vendor",
        "bin-dir": ".build/bin",
        "sort-packages": true,
		"lock": true,
        "allow-plugins": {
			"ergebnis/composer-normalize": true,
			"phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "scripts": {

    },
    "extra": {
        "typo3/cms": {
			"extension-key": "consent_banner",
            "web-dir": ".build/public"
        }
    }
}
